{
  "expo": {
    "name": "RSA Agentes",
    "slug": "rsaagentsapp",
    "privacy": "public",
    "platforms": ["ios", "android"],
    "version": "1.0.6",
    "orientation": "portrait",

    "splash": {
      "image": "./assets/images/intro_rsa_agente.png",
      "resizeMode": "cover"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "notification": {
      "icon": "./assets/images/icon_notf.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ec.pulpo.agents.rsa",
      "buildNumber": "10"
    },
    "android": {
      "versionCode": 10,
      "package": "ec.pulpo.agents.rsa",
      "googleServicesFile": "./google-services.json",
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "f42c6618-fc5f-4c0d-a8f0-091a70a6fd88"
      }
    },
    "plugins": ["expo-font"]
  }
}
