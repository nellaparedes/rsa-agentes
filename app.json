{
  "expo": {
    "name": "RSA Agentes",
    "slug": "rsaagentsapp",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon-app.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "atc.agents.rsa",
      "buildNumber": "20"
    },
    "android": {
      "versionCode": 20,
      "package": "atc.agents.rsa",
      "googleServicesFile": "./google-services.json",
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "f42c6618-fc5f-4c0d-a8f0-091a70a6fd88"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon_notf.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/intro_rsa_agente.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
